    <string name="routelog_notification_upload_empty_text">No GPS points were recorded, so nothing was sent to %1$s.</string>
    <string name="routelog_notification_upload_no_grant_title">Upload not possible</string>
    <string name="routelog_notification_upload_no_grant_text">This phone can\'t upload the route to %1$s (for example after restoring from a backup). It stays here; you can export it as GPX.</string>
    <string name="routelog_gpx_track_name">routelog %1$s</string>
    <string name="routelog_distance_km">%1$.1f km</string>
    <string name="routelog_status_starting">Starting…</string>
    <string name="routelog_storage_error">Points can\'t be saved. Check free storage.</string>
    <string name="routelog_gps_off">Location is turned off</string>
    <string name="routelog_gps_searching">Waiting for GPS signal</string>
    <string name="routelog_gps_fix">GPS signal OK</string>
