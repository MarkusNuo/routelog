<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Which files may be backed up at all; whether a backup happens is
     decided at runtime by RoutelogBackupAgent (user consent, encryption). The upload tokens
     (TokenStore) are never part of a backup, neither in the cloud nor in a device transfer. They
     now live under noBackupFilesDir, which Android never backs up; upload_tokens.xml is the file
     older versions wrote, left out for phones that were not migrated yet. The same goes for the
     battery exemption flags (BatteryOptimization): the exemption is per phone. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include
            domain="database"
            path="." />
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="upload_tokens.xml" />
        <exclude
            domain="sharedpref"
            path="device_state.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="upload_tokens.xml" />
        <exclude
            domain="sharedpref"
            path="device_state.xml" />
    </device-transfer>
</data-extraction-rules>
