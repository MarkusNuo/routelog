    <!-- Backup -->
    <string name="backup_title">Back up recordings?</string>
    <string name="backup_message">routelog can include your recordings in Android backup, so they can be restored on a new phone. Recordings show where you drove.\n\nCloud backup only happens if it is end-to-end encrypted, which needs a screen lock. Moving data directly to a new phone is included.\n\nYou can change this later in the menu. Turning backup off stops future backups, but a backup that already exists may remain until Android replaces it.</string>
    <string name="backup_state_on">Backup is currently on.</string>
    <string name="backup_state_off">Backup is currently off.</string>
    <string name="backup_yes">Back up</string>
    <string name="backup_no">Don\'t back up</string>
    <string name="backup_unavailable">Backing up recordings isn\'t available on this Android version. Export recordings as GPX files to keep a copy.</string>

    <!-- Reasons a recording can't start -->
    <string name="blocker_location_title">Location access needed</string>
    <string name="blocker_location_message">routelog needs your precise location to record a route.</string>
    <string name="blocker_location_settings_message">Location access is turned off for routelog. Allow location with \"Use precise location\" in the app settings.</string>
    <string name="blocker_precise_title">Precise location needed</string>
    <string name="blocker_precise_message">routelog only has your approximate location, which is not enough to record a route.</string>
    <string name="blocker_precise_settings_message">routelog only has your approximate location. Turn on \"Use precise location\" in the app settings.</string>
    <string name="blocker_notifications_title">Notifications needed</string>
    <string name="blocker_notifications_message">While recording, routelog shows a notification so you can always see that a route is being recorded, also on the lock screen.</string>
    <string name="blocker_notifications_settings_message">While recording, routelog shows a notification so you can always see that a route is being recorded, also on the lock screen. Allow routelog\'s notifications in the settings.</string>
    <string name="blocker_gps_off_title">Location is off</string>
